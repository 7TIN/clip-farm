{
  "name": "api",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "APP_ENV=dev bun --watch src/index.ts",
    "setup:python-first": "uv venv && uv pip install -r requirements.txt && mkdir -p models && curl -L https://storage.googleapis.com/mediapipe-models/face_detector/blaze_face_short_range/float16/latest/blaze_face_short_range.tflite -o models/blaze_face_short_range.tflite",
    "setup:python": "uv pip install -r requirements.txt",
    "start": "bun src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.469",
    "@remotion/google-fonts": "4.0.469",
    "@remotion/media": "4.0.469",
    "@remotion/renderer": "4.0.469",
    "hono": "^4.12.19",
    "remotion": "4.0.469"
  }
}
