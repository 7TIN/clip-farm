{
  "name": "api",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "APP_ENV=dev bun --watch src/index.ts",
    "setup:python-first": "uv venv && uv pip install -r requirements.txt",
